# --- Base de données ---
# Rôle applicatif soumis à la Row Level Security (jamais propriétaire des tables)
DATABASE_URL="postgresql://revio_app:revio_app_dev@localhost:5432/revio"
# Rôle système (BYPASSRLS) : authentification, admin Revio, jobs. Toujours audité.
SYSTEM_DATABASE_URL="postgresql://revio_system:revio_system_dev@localhost:5432/revio"
# Propriétaire du schéma : migrations uniquement
MIGRATION_DATABASE_URL="postgresql://revio_owner:revio_owner_dev@localhost:5432/revio"

# --- Secrets (générer avec : openssl rand -base64 32) ---
# Clé AES-256-GCM pour chiffrer les numéros de téléphone et les secrets 2FA
DATA_ENCRYPTION_KEY="REMPLACER_PAR_32_OCTETS_BASE64"
# Clé HMAC-SHA256 pour l'empreinte de recherche des numéros
LOOKUP_HMAC_KEY="REMPLACER_PAR_32_OCTETS_BASE64"

# --- SMS ---
# "console" (dev : le code s'affiche dans les logs) ou "brevo"
SMS_PROVIDER="console"
BREVO_API_KEY=""
SMS_SENDER="Revio"

APP_URL="http://localhost:3000"
